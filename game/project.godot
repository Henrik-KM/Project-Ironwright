; Engine configuration file.
; Project Ironwright commercial release candidate.
config_version=5

[application]

config/name="Project Ironwright"
config/version="1.0.0-rc.1"
config/description="A long-form survival-strategy game about one weak Mechromancer and an increasingly autonomous machine society defending a single Heartforge."
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://scenes/main_3d.tscn"
config/icon="res://icon.svg"
boot_splash/image="res://icon.svg"
boot_splash/bg_color=Color(0.008, 0.018, 0.024, 1)

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.01, 0.012, 0.015, 1)

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=18.0

[audio]

driver/enable_input=false
default_bus_layout="res://default_bus_layout.tres"

[internationalization]

locale/fallback="en"
